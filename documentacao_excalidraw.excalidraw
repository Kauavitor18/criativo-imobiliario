      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yxsQ9n0G1hRberoYG7ryN",
      "type": "text",
      "x": 2615.8256714836007,
      "y": 1375.4444444444453,
      "width": 773.4994506835938,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ab",
      "roundness": null,
      "seed": 999671388,
      "version": 130,
      "versionNonce": 1257981156,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1770054912299,
      "link": null,
      "locked": false,
      "text": "\\n\\n# ESTILO DO SEGMENTO: HIGH_END\\nApply a high-end, luxury visual\ndirection.\\nUse refined color palettes such as deep neutrals, soft blacks, warm\ngrays, champagne, gold accents, or muted earth tones.\\n\\nLighting should feel\ncontrolled and cinematic.\\nDesign must communicate exclusivity, elegance, and\nsophistication.\\n\\nUse minimal but intentional overlays, precise typography, and\nsubtle premium details.\\nEverything should feel restrained, polished, and\nconfident — never flashy or crowded.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\\n\\n# ESTILO DO SEGMENTO: HIGH_END\\nApply a high-end, luxury visual direction.\\nUse refined color palettes such as deep neutrals, soft blacks, warm grays, champagne, gold accents, or muted earth tones.\\n\\nLighting should feel controlled and cinematic.\\nDesign must communicate exclusivity, elegance, and sophistication.\\n\\nUse minimal but intentional overlays, precise typography, and subtle premium details.\\nEverything should feel restrained, polished, and confident — never flashy or crowded.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "cZsxi7iwJ4Z3g72Mi5asU",
      "type": "text",
      "x": 2618.401302761502,
      "y": 1840.0873015873026,
      "width": 766.9196166992188,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ac",
      "roundness": null,
      "seed": 325243364,
      "version": 156,
      "versionNonce": 1381393380,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1770054917065,
      "link": null,
      "locked": false,
      "text": "\\n\\n\\n\\n\\n# IMPORTANTE - SEM LOGO\\nNENHUMA LOGO FOI FORNECIDA\nPELO USUÁRIO.\n\nPROIBIÇÕES ABSOLUTAS (NÃO VIOLE NENHUMA):\\n❌ NÃO escreva a\npalavra \\\"LOGO\\\", \\\"Logo\\\" ou \\\"logo\\\"\\n❌ NÃO crie texto representando\nmarca ou logo\\n❌ NÃO desenhe letras isoladas (L, M, etc.) como\nplaceholder\\n❌ NÃO adicione símbolos genéricos no lugar de logo\\n❌ NÃO\nreserve espaço visual para uma logo inexistente\\n❌ NÃO crie ícones ou\nformas abstratas representando marca\\n\\nA arte deve ser criada\nCOMPLETAMENTE SEM elementos de marca/logotipo.\\nFoque apenas no\nimóvel, textos descritivos e elementos decorativos do design.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\\n\\n\\n\\n\\n# IMPORTANTE - SEM LOGO\\nNENHUMA LOGO FOI FORNECIDA PELO USUÁRIO.\n\nPROIBIÇÕES ABSOLUTAS (NÃO VIOLE NENHUMA):\\n❌ NÃO escreva a palavra \\\"LOGO\\\", \\\"Logo\\\" ou \\\"logo\\\"\\n❌ NÃO crie texto representando marca ou logo\\n❌ NÃO desenhe letras isoladas (L, M, etc.) como placeholder\\n❌ NÃO adicione símbolos genéricos no lugar de logo\\n❌ NÃO reserve espaço visual para uma logo inexistente\\n❌ NÃO crie ícones ou formas abstratas representando marca\\n\\nA arte deve ser criada COMPLETAMENTE SEM elementos de marca/logotipo.\\nFoque apenas no imóvel, textos descritivos e elementos decorativos do design.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "1JBeqnmCheB_zKroZSL6w",
      "type": "text",
      "x": 2609.102426680307,
      "y": 1729.9444444444453,
      "width": 969.4720458984378,
      "height": 27,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
