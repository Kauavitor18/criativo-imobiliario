    {
      "id": "5riBdaY5GoalYgM2WpYk6",
      "type": "text",
      "x": 3830.509958418588,
      "y": 2194.293650793652,
      "width": 789.0594482421875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0K",
      "roundness": null,
      "seed": 1187941476,
      "version": 152,
      "versionNonce": 1337275100,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1770055426743,
      "link": null,
      "locked": false,
      "text": "\"summary\": \"A identidade visual da Elevé Soluções Imobiliárias transmite\nmodernidade, confiança e sofisticação, com um foco em apresentar imóveis que se\nintegram ao estilo de vida dos clientes. A marca cria uma conexão inspiradora\nentre a moradia e a realização pessoal, destacando a segurança e o investimento\ninteligente.\",",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"summary\": \"A identidade visual da Elevé Soluções Imobiliárias transmite modernidade, confiança e sofisticação, com um foco em apresentar imóveis que se integram ao estilo de vida dos clientes. A marca cria uma conexão inspiradora entre a moradia e a realização pessoal, destacando a segurança e o investimento inteligente.\",",
      "autoResize": false,
      "lineHeight": 1.25
    },
