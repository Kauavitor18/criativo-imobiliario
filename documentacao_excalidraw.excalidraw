      "isDeleted": false,
      "boundElements": null,
      "updated": 1770056488733,
      "link": null,
      "locked": false,
      "text": "Támbem teremos a aba de historico de imagens criadas, cada cliente conectado e\n cadastrado terá seu banco com suas informações e historico de imagens de criativos",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Támbem teremos a aba de historico de imagens criadas, cada cliente conectado e\n cadastrado terá seu banco com suas informações e historico de imagens de criativos",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pnek2mq3S_R-LMMJbC5qV",
      "type": "text",
      "x": 2741.587301587302,
      "y": 121.51587301587392,
      "width": 558.8076293945312,
